---
import { siteConfig } from "../config";
const writing = siteConfig.writing || [];
---

{writing.length > 0 && (
  <section id="writing" class="section-shell bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20 sm:px-10 sm:py-24 lg:px-12 lg:py-32">
      <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
        <div>
          <p class="section-kicker">04 / Writing</p>
          <h2 class="section-title mt-4">Thinking in public about industrial systems.</h2>
        </div>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {writing.map((post, index) => (
          <article class="group rounded-2xl border border-slate-200 bg-white p-6 transition hover:-translate-y-1 hover:border-teal-300 hover:shadow-lg hover:shadow-teal-950/10">
            <div class="flex items-center justify-between gap-4">
              <span class="font-mono text-xs font-bold tracking-[0.2em] text-teal-700">0{index + 1}</span>
              <time class="text-xs text-slate-400">{new Date(post.date).toLocaleDateString("en-US", { month: "short", year: "numeric" })}</time>
            </div>
            <h3 class="mt-4 text-lg font-bold text-slate-950 group-hover:text-teal-700 transition">{post.title}</h3>
            <div class="mt-3 flex flex-wrap gap-1.5">
              {post.tags.map((tag) => (
                <span class="rounded-full border border-slate-200 px-2 py-0.5 text-[0.65rem] font-medium text-slate-500">{tag}</span>
              ))}
            </div>
            <a href={post.link} target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-teal-700 hover:text-teal-900 transition">
              Read <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
)}