---
import { siteConfig } from "../config";
const featuredProjects = siteConfig.projects.filter((project) => project.featured);
const otherProjects = siteConfig.projects.filter((project) => !project.featured);
---

<section id="projects" class="section-shell bg-slate-50">
  <div class="mx-auto max-w-7xl px-6 py-20 sm:px-10 sm:py-24 lg:px-12 lg:py-32">
    <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
      <div>
        <p class="section-kicker">03 / Selected work</p>
        <h2 class="section-title mt-4">Systems that solve a real problem.</h2>
      </div>
      <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm font-bold text-teal-700 transition hover:text-teal-900">
        See all on GitHub <span aria-hidden="true">↗</span>
      </a>
    </div>

    <div class="mt-12 grid gap-5 lg:grid-cols-3">
      {featuredProjects.map((project, index) => (
        <a href={project.link} target="_blank" rel="noopener noreferrer" class={`project-card group flex min-h-[22rem] flex-col rounded-3xl border border-slate-200 bg-white p-6 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-teal-300 hover:shadow-xl hover:shadow-teal-950/10 sm:p-7 ${index === 0 ? "lg:col-span-2" : ""}`}>
          <div class="flex items-start justify-between gap-4">
            <span class="font-mono text-xs font-bold tracking-[0.2em] text-teal-700">0{index + 1} / FEATURED</span>
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-slate-950 text-white transition group-hover:rotate-45">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M17 7H7M17 7v10" /></svg>
            </span>
          </div>
          <div class="mt-auto pt-16">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-400">{project.outcome}</p>
            <h3 class="mt-3 text-2xl font-black tracking-[-0.03em] text-slate-950 sm:text-3xl">{project.name}</h3>
            <p class="mt-4 max-w-2xl text-sm leading-6 text-slate-600 sm:text-base sm:leading-7">{project.description}</p>
            <div class="mt-6 flex flex-wrap gap-2">
              {project.skills.map((skill) => <span class="rounded-md bg-slate-100 px-2.5 py-1.5 text-xs font-semibold text-slate-600">{skill}</span>)}
            </div>
          </div>
        </a>
      ))}
    </div>

    {otherProjects.length > 0 && (
      <div class="mt-5 grid gap-5 md:grid-cols-2">
        {otherProjects.map((project) => (
          <a href={project.link} target="_blank" rel="noopener noreferrer" class="project-card group rounded-3xl border border-slate-200 bg-white p-6 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-teal-300 hover:shadow-lg hover:shadow-teal-950/10 sm:p-7">
            <div class="flex items-center justify-between gap-4">
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-400">{project.outcome}</p>
              <span class="text-slate-400 transition group-hover:-translate-y-1 group-hover:translate-x-1 group-hover:text-teal-700" aria-hidden="true">↗</span>
            </div>
            <h3 class="mt-10 text-2xl font-black tracking-[-0.03em] text-slate-950">{project.name}</h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">{project.description}</p>
            <div class="mt-6 flex flex-wrap gap-2">
              {project.skills.map((skill) => <span class="rounded-md bg-slate-100 px-2.5 py-1.5 text-xs font-semibold text-slate-600">{skill}</span>)}
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</section>
