---
import { siteConfig } from "../config";
---

<section class="section-shell" style="background: var(--color-bg);">
  <div class="mx-auto max-w-7xl px-6 py-20 sm:px-10 sm:py-24 lg:px-12 lg:py-32">
    <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
      <div class="animate-fade-in-up">
        <p class="section-kicker text-[var(--color-accent)]">02 / What I do</p>
        <h2 class="section-title mt-4">From first prototype to dependable operation.</h2>
      </div>
      <p class="max-w-sm text-sm leading-6 text-[var(--color-fg-muted)] animate-fade-in-up animation-delay-100">A practical bridge between industrial constraints and software possibilities.</p>
    </div>

    <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {siteConfig.services.map((service, index) => (
        <article class="card-interactive p-6 reveal reveal-delay-{index + 1}">
          <div class="flex items-start justify-between gap-4">
            <span class="font-mono text-xs font-bold tracking-[0.2em] text-[var(--color-accent)]">0{index + 1}</span>
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[var(--color-accent-bg)] text-[var(--color-accent)]">
              {service.icon === "chip" ? (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="2" /><path d="M9 9h6v6H9zM9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4" /></svg>
              ) : service.icon === "gauge" ? (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 16a8 8 0 1 1 16 0" /><path d="m12 12 4-4" /><path d="M5 20h14" /></svg>
              ) : service.icon === "database" ? (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="5" rx="9" ry="3" /><path d="M3 5v14a9 3 0 0 0 18 0V5" /><path d="M3 12a9 3 0 0 0 18 0" /></svg>
              ) : (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 18a8 8 0 0 1 16 0" /><path d="M12 18v-5" /><path d="M5 4v3M19 4v3M3 10h3M18 10h3" /></svg>
              )}
            </span>
          </div>
          <h3 class="mt-10 text-xl font-bold tracking-tight text-[var(--color-fg)]">{service.title}</h3>
          <p class="mt-3 text-sm leading-6 text-[var(--color-fg-muted)]">{service.description}</p>
          {service.outcomes && (
            <ul class="mt-6 space-y-2.5">
              {service.outcomes.map((outcome) => (
                <li class="flex items-center gap-2 text-xs text-[var(--color-fg-muted)]">
                  <span class="flex h-4 w-4 shrink-0 items-center justify-center text-[var(--color-accent)]">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                  </span>
                  {outcome}
                </li>
              ))}
            </ul>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  });
</script>