---
import { siteConfig } from "../config";
---

<footer class="border-t border-slate-200 bg-white">
  <div class="mx-auto flex max-w-7xl flex-col gap-8 px-6 py-10 sm:px-10 md:flex-row md:items-center md:justify-between lg:px-12">
    <div>
      <p class="text-lg font-black tracking-tight text-slate-950">{siteConfig.name}</p>
      <p class="mt-1 text-sm text-slate-500">Embedded systems · Industrial IoT · Edge-to-cloud</p>
    </div>
    <div class="flex flex-wrap items-center gap-5 text-sm font-semibold text-slate-600">
      <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" class="transition hover:text-teal-700">GitHub</a>
      <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" class="transition hover:text-teal-700">LinkedIn</a>
      <a href={`mailto:${siteConfig.social.email}`} class="transition hover:text-teal-700">Email</a>
    </div>
    <p class="text-xs text-slate-400">© {new Date().getFullYear()} {siteConfig.name}</p>
  </div>
</footer>
