---
import { siteConfig } from "../config";
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
---

{hasEducation && (
  <section id="education" class="section-shell bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-20 sm:px-10 sm:py-24 lg:px-12 lg:py-32">
      <div class="grid gap-12 lg:grid-cols-[0.72fr_1.28fr] lg:gap-20">
        <div>
          <p class="section-kicker">05 / Foundation</p>
          <h2 class="section-title mt-4">Curiosity, applied.</h2>
          <p class="mt-6 max-w-sm text-base leading-7 text-slate-500">A computer science foundation, extended through automation, research, and hands-on systems work.</p>
        </div>

        <div class="space-y-8">
          {siteConfig.education.map((education) => (
            <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
              <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-start">
                <div>
                  <p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-teal-700">Education</p>
                  <h3 class="mt-3 text-2xl font-black tracking-[-0.03em] text-slate-950">{education.degree}</h3>
                  <p class="mt-2 font-semibold text-slate-600">{education.school}</p>
                </div>
                <p class="shrink-0 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">{education.dateRange}</p>
              </div>
              <ul class="mt-7 space-y-3 border-t border-slate-100 pt-6">
                {education.achievements.map((achievement) => (
                  <li class="flex gap-3 text-sm leading-6 text-slate-600 sm:text-base sm:leading-7">
                    <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-teal-500" aria-hidden="true"></span>
                    <span>{achievement}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}

          <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
            <p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-teal-700">Continuous learning</p>
            <h3 class="mt-3 text-xl font-black tracking-tight text-slate-950">Selected certifications</h3>
            <ul class="mt-5 grid gap-3 sm:grid-cols-2">
              {siteConfig.certifications.map((certification) => (
                <li class="flex items-start gap-2.5 text-sm leading-6 text-slate-600">
                  <span class="mt-1 text-teal-600" aria-hidden="true">✓</span>
                  <span>{certification}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
)}
