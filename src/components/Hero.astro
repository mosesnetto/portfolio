---
import { siteConfig } from "../config";
---

<div
  id="hero"
  class="hero-shell relative isolate overflow-hidden"
  style={`--accent-color: ${siteConfig.accentColor}`}
>
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-glow hero-glow-one" aria-hidden="true"></div>
  <div class="hero-glow hero-glow-two" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto flex min-h-[calc(100vh-2rem)] max-w-7xl items-center px-6 py-16 sm:px-10 lg:px-12">
    <div class="grid w-full items-center gap-14 lg:grid-cols-[1.15fr_0.85fr] lg:gap-20">
      <div class="max-w-3xl animate-fade-in-up">
        <div class="mb-7 inline-flex items-center gap-2 rounded-full border border-[var(--color-accent-border)] bg-[var(--color-accent-bg)]/80 px-4 py-2 text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-accent)] shadow-sm backdrop-blur">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[var(--color-accent)]/30"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-[var(--color-accent)]"></span>
          </span>
          {siteConfig.hero.availability}
        </div>

        <p class="mb-5 font-mono text-sm font-semibold uppercase tracking-[0.22em] text-[var(--color-accent)] sm:text-base">
          {siteConfig.hero.eyebrow}
        </p>
        <h1 class="max-w-4xl text-5xl font-black leading-[0.98] tracking-[-0.055em] text-[var(--color-fg)] sm:text-6xl lg:text-8xl">
          {siteConfig.hero.headline}
        </h1>
        <p class="mt-8 max-w-2xl text-lg leading-8 text-[var(--color-fg-muted)] sm:text-xl sm:leading-9">
          {siteConfig.hero.summary}
        </p>

        <div class="mt-10 flex flex-wrap gap-3">
          <a href="#projects" class="button button-primary">
            Explore selected work
            <span aria-hidden="true">↗</span>
          </a>
          <a href={`mailto:${siteConfig.social.email}`} class="button button-secondary">
            Start a conversation
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-3 text-sm text-[var(--color-fg-muted)]">
          <span class="inline-flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-[var(--color-accent)]"></span>
            {siteConfig.hero.location}
          </span>
          <span class="hidden sm:inline">·</span>
          <span class="hidden sm:inline">Embedded · Edge · Cloud</span>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-md lg:max-w-none animate-fade-in-up animation-delay-200">
        <div class="absolute -inset-5 rounded-[2.5rem] bg-gradient-to-br from-[var(--color-accent)]/20 via-[var(--color-accent-light)]/10 to-transparent blur-2xl" aria-hidden="true"></div>
        <div class="relative overflow-hidden rounded-[2rem] border border-[var(--color-border)] bg-[var(--color-bg-elevated)]/80 p-3 shadow-2xl shadow-[var(--color-card-shadow)] backdrop-blur">
          <div class="relative aspect-[4/5] overflow-hidden rounded-[1.4rem] bg-[var(--color-fg)]">
            <img
              src={siteConfig.avatar}
              alt={`${siteConfig.name} profile portrait`}
              class="h-full w-full object-cover object-top"
              width="460"
              height="575"
            />
            <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-[var(--color-fg)]/95 to-transparent"></div>
            <div class="absolute bottom-5 left-5 right-5 text-[var(--color-bg-elevated)]">
              <p class="font-mono text-xs uppercase tracking-[0.2em] text-[var(--color-accent-light)]">Profile</p>
              <p class="mt-1 text-2xl font-bold tracking-tight">{siteConfig.name}</p>
              <p class="mt-1 text-sm text-[var(--color-fg-muted)]">Building useful systems from the edge up.</p>
            </div>
          </div>
        </div>
        <div class="absolute -bottom-5 -left-5 hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-elevated)]/90 px-4 py-3 shadow-xl shadow-[var(--color-card-shadow)] backdrop-blur sm:block animate-fade-in-up animation-delay-400">
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-[var(--color-fg-subtle)]">Currently</p>
          <p class="mt-1 text-sm font-semibold text-[var(--color-fg)]">Building at Hanoch Automations</p>
        </div>
      </div>
    </div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-6 pb-10 sm:px-10 lg:px-12">
    <div class="grid overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-elevated)]/75 shadow-sm backdrop-blur sm:grid-cols-3">
      {siteConfig.hero.highlights.map((highlight, index) => (
        <div class={`flex items-center gap-3 px-5 py-4 text-sm text-[var(--color-fg-muted)] ${index > 0 ? "border-t border-[var(--color-border)] sm:border-l sm:border-t-0" : ""}`}>
          <span class="font-mono text-xs font-bold text-[var(--color-accent)]">0{index + 1}</span>
          <span>{highlight}</span>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .hero-shell {
    background:
      radial-gradient(circle at 12% 12%, rgba(20, 184, 166, 0.12), transparent 28%),
      linear-gradient(135deg, var(--color-bg) 0%, var(--color-accent-bg) 48%, var(--color-bg) 100%);
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    opacity: 0.3;
    background-image:
      linear-gradient(var(--color-accent-bg) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-accent-bg) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(to bottom, black, transparent 78%);
  }

  .hero-glow {
    position: absolute;
    border-radius: 999px;
    filter: blur(1px);
  }

  .hero-glow-one {
    top: 12%;
    right: -8rem;
    width: 28rem;
    height: 28rem;
    background: rgba(103, 232, 249, 0.15);
  }

  .hero-glow-two {
    bottom: -12rem;
    left: 28%;
    width: 34rem;
    height: 34rem;
    background: rgba(153, 246, 228, 0.12);
  }

  @media (prefers-color-scheme: dark) {
    .hero-shell {
      background:
        radial-gradient(circle at 12% 12%, rgba(20, 184, 166, 0.08), transparent 28%),
        linear-gradient(135deg, var(--color-bg) 0%, var(--color-accent-bg)/20 48%, var(--color-bg) 100%);
    }
    .hero-grid {
      opacity: 0.15;
    }
    .hero-glow-one {
      background: rgba(103, 232, 249, 0.08);
    }
    .hero-glow-two {
      background: rgba(153, 246, 228, 0.06);
    }
  }
</style>