---
import { siteConfig } from "../config";
---

<section id="contact" class="section-shell bg-slate-950 text-white">
  <div class="mx-auto max-w-7xl px-6 py-20 sm:px-10 sm:py-24 lg:px-12 lg:py-32">
    <div class="relative overflow-hidden rounded-[2rem] border border-white/10 bg-gradient-to-br from-teal-950 via-slate-900 to-slate-950 p-8 sm:p-12 lg:p-16">
      <div class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-teal-400/15 blur-3xl" aria-hidden="true"></div>
      <div class="absolute -bottom-32 left-1/3 h-80 w-80 rounded-full bg-cyan-400/10 blur-3xl" aria-hidden="true"></div>
      <div class="relative max-w-3xl">
        <p class="section-kicker text-teal-300">06 / Contact</p>
        <h2 class="mt-4 text-4xl font-black tracking-[-0.05em] sm:text-6xl">Have a hard systems problem?</h2>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">I would be glad to hear about the machine, the data, or the product you are trying to make reliable. Let’s turn the next constraint into a working system.</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={`mailto:${siteConfig.social.email}`} class="button button-light">Email me <span aria-hidden="true">↗</span></a>
          <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" class="button button-outline-light">Connect on LinkedIn <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="relative mt-12 flex flex-wrap gap-x-8 gap-y-3 border-t border-white/10 pt-6 text-sm text-slate-400">
        <span>{siteConfig.hero.location}</span>
        <span>{siteConfig.hero.availability}</span>
      </div>
    </div>
  </div>
</section>
